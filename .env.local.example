# Must be a Supabase project in eu-central-1 (Frankfurt) for GDPR compliance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL — REQUIRED for email confirmation redirects in production
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# AI Life Interviews (server-side only)
ANTHROPIC_API_KEY=

# Email (for invite notifications — optional, degrades gracefully)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@memorypalace.app

# Google Photos OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox OAuth (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# OneDrive / Microsoft OAuth (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Box OAuth (https://developer.box.com/guides/applications/)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Price IDs (create products in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_KEEPER_PRICE_ID=
NEXT_PUBLIC_STRIPE_KEEPER_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_GUARDIAN_PRICE_ID=
NEXT_PUBLIC_STRIPE_GUARDIAN_MONTHLY_PRICE_ID=
STRIPE_KEEPER_PRICE_ID=
STRIPE_KEEPER_MONTHLY_PRICE_ID=
STRIPE_GUARDIAN_PRICE_ID=
STRIPE_GUARDIAN_MONTHLY_PRICE_ID=

# €49/€79 annual-default reprice (SUCCESS_PLAYBOOK Pillar 2 §2).
# Create the new prices in the Stripe Dashboard and paste their IDs here; while
# empty, the app gracefully falls back to the legacy price IDs above AND keeps
# displaying the legacy prices (the shown price always matches what Stripe
# charges). Monthly decoy prices (€9.99 / €14.99) are optional — without them
# the legacy monthly prices stay the decoy.
NEXT_PUBLIC_STRIPE_KEEPER_ANNUAL49_PRICE_ID=
NEXT_PUBLIC_STRIPE_GUARDIAN_ANNUAL79_PRICE_ID=
NEXT_PUBLIC_STRIPE_KEEPER_MONTHLY999_PRICE_ID=
NEXT_PUBLIC_STRIPE_GUARDIAN_MONTHLY1499_PRICE_ID=

# Upstash Redis (https://console.upstash.com — distributed rate limiting)
# Use eu-central-1 region for GDPR compliance
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push / VAPID (generate once via: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@thememorypalace.ai

# Cron secret (used by Vercel Cron to authenticate /api/notifications/send)
CRON_SECRET=

# PostHog analytics (unified behaviour + revenue portal)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side product milestones (memory_created, interview_completed, wing_published,
# photo_restore_used) — first-party, keyed by uid, covers native. Set "0" to disable.
POSTHOG_SERVER_CAPTURE=1
# LEG-012: GDPR erasure of the PostHog person (uid + display-name property + events)
# when a user deletes their account. Personal API key (private API, scope
# person:write) + numeric project id — NOT the public NEXT_PUBLIC_POSTHOG_KEY.
# If unset, account deletion still works; the PostHog wipe is skipped with a warn.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Lifecycle emails (weekly report, monthly report, 30-day win-back).
# Master switch: keep UNSET (or anything other than "true") to keep the whole
# program DEACTIVATED. While unset, /api/email/digest, /api/email/monthly,
# the win-back branch of /api/cron/drip-and-reengage AND the trial-ending
# (trial_will_end webhook) email early-return and send nothing — the crons in
# vercel.json run but no-op. Set to "true" only after the migration is applied
# and the emails are reviewed.
LIFECYCLE_EMAILS_ENABLED=

# RevenueCat (see docs/REVENUECAT_INTEGRATION_PLAN.md)
# Native SDK public key (iOS/Android) — safe to expose in the app bundle
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Shared secret configured as the Authorization header on the RC webhook
REVENUECAT_WEBHOOK_AUTH=
# Master switch: keep "false" until the RC dashboard + migration are in place.
# While false, /api/revenuecat/webhook is a no-op (shadow) and never mutates billing.
RC_WEBHOOK_ENABLED=false
